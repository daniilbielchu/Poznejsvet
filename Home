<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Poznej svět kolem sebe</title>
    <script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>
    <style>
        /* CSS STYLY - VZHLED APLIKACE */
        :root {
            --primary-color: #2E7D32; /* Tmavě zelená */
            --accent-color: #FFC107; /* Žlutá */
            --bg-color: #f4f4f4;
            --text-color: #333;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 0;
            background-color: var(--bg-color);
            color: var(--text-color);
            text-align: center;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        header {
            background-color: var(--primary-color);
            color: white;
            padding: 15px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.2);
        }

        h1 { margin: 0; font-size: 1.5rem; }
        h2 { color: var(--primary-color); }

        main {
            flex: 1;
            padding: 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        /* Sekce (Stránky) */
        .screen {
            display: none; /* Všechny skryté, JS zobrazí potřebnou */
            width: 100%;
            max-width: 600px;
            animation: fadeIn 0.5s;
        }

        .screen.active { display: block; }

        /* Tlačítka */
        button {
            background-color: var(--primary-color);
            color: white;
            border: none;
            padding: 15px 30px;
            font-size: 1.2rem;
            border-radius: 50px;
            cursor: pointer;
            margin: 10px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            transition: transform 0.1s;
        }

        button:active { transform: scale(0.98); }
        button.secondary { background-color: #555; }
        button.emergency-btn { background-color: #d32f2f; font-size: 1rem; padding: 10px 20px; }

        /* Inputy */
        input[type="text"] {
            padding: 10px;
            font-size: 1.2rem;
            width: 80%;
            margin: 10px 0;
            border: 2px solid #ddd;
            border-radius: 8px;
        }

        /* Kompas / Šipka */
        #compass-container {
            position: relative;
            width: 200px;
            height: 200px;
            margin: 20px auto;
            border: 5px solid #ddd;
            border-radius: 50%;
            background: white;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        #arrow {
            font-size: 100px;
            color: var(--primary-color);
            transform-origin: center;
            transition: transform 0.3s ease-out;
        }

        .distance-info {
            font-size: 1.5rem;
            font-weight: bold;
            margin-top: 10px;
        }

        /* QR Skener okno */
        #reader {
            width: 100%;
            border-radius: 10px;
            overflow: hidden;
            background: #000;
        }

        /* Footer s kontakty */
        footer {
            background-color: #333;
            color: #aaa;
            padding: 20px;
            font-size: 0.9rem;
        }
        
        .contact-box {
            border-top: 1px solid #555;
            margin-top: 10px;
            padding-top: 10px;
        }

        .contact-box strong { color: white; display: block; margin-bottom: 5px;}
        .contact-box a { color: var(--accent-color); text-decoration: none; }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body>

    <header>
        <h1>Poznej svět kolem sebe</h1>
    </header>

    <main>
        <div id="screen-welcome" class="screen active">
            <h2>Vítejte ve hře!</h2>
            <p>Čeká vás trasa plná úkolů. Najděte první stanoviště a naskenujte QR kód.</p>
            <button onclick="showScanner()">📷 Naskenovat QR kód</button>
            <p style="font-size: 0.8rem; color: #666;">(Aplikace si vyžádá přístup ke kameře)</p>
        </div>

        <div id="screen-scanner" class="screen">
            <h2>Hledám QR kód...</h2>
            <div id="reader"></div>
            <p id="scan-error" style="color: red; display: none;">Kamera není povolena.</p>
            <button class="secondary" onclick="stopScannerAndReturn()">Zrušit</button>
        </div>

        <div id="screen-task" class="screen">
            <h2 id="task-title">Úkol č. 1</h2>
            <p id="task-desc">Zde se objeví zadání úkolu...</p>
            <input type="text" id="task-answer" placeholder="Zadejte odpověď">
            <button onclick="checkAnswer()">Ověřit odpověď</button>
            <p id="feedback" style="font-weight: bold;"></p>
        </div>

        <div id="screen-compass" class="screen">
            <h2>Správně! Pokračujte dál.</h2>
            <p>Jděte ve směru šipky k dalšímu bodu.</p>
            
            <button id="ios-perm-btn" onclick="requestDeviceOrientation()" style="display:none; font-size:0.8rem; background:#444;">Povolit kompas (iOS)</button>

            <div id="compass-container">
                <div id="arrow">⬆</div>
            </div>
            
            <div class="distance-info">
                Vzdálenost: <span id="distance-meter">--</span> m
            </div>
            
            <p style="font-size: 0.9rem; margin-top:20px;">Nevíte si rady?</p>
            <button class="secondary" onclick="openMapyCZ()">🗺️ Otevřít v Mapy.cz</button>
            
            <br><br>
            <button onclick="showScanner()">Jsem na místě! (Skenovat další)</button>
        </div>
        
        <div id="screen-finish" class="screen">
            <h2>Gratulujeme!</h2>
            <p>Dokončili jste celou trasu.</p>
            <div style="font-size: 3rem;">🏆</div>
        </div>

    </main>

    <footer>
        <div class="emergency-contacts">
            <button class="emergency-btn" onclick="window.location.href='tel:112'">SOS 112</button>
        </div>
        
        <div class="contact-box">
            <strong>Provozovatel:</strong>
            Tomáš Novák<br>
            <a href="tel:+42077320951">+420 773 209 51</a>
        </div>
    </footer>

    <script>
        // --- KONFIGURACE HRY ---
        const stages = [
            {
                id: 1,
                qrCode: "stanoviste-1", 
                question: "Kolik soch je na Karlově mostě? (Napiš číslo)",
                answer: "30",
                nextLocation: { lat: 50.086385, lng: 14.413280 } 
            },
            {
                id: 2,
                qrCode: "stanoviste-2",
                question: "Jak se jmenuje tento kostel?",
                answer: "mikulas", 
                nextLocation: { lat: 50.091395, lng: 14.398679 } 
            }
        ];

        // --- STAV APLIKACE ---
        let currentStageIndex = 0;
        let html5QrcodeScanner = null;
        let watchId = null;

        function showScreen(screenId) {
            document.querySelectorAll('.screen').forEach(el => el.classList.remove('active'));
            document.getElementById(screenId).classList.add('active');
        }

        // --- VYLEPŠENÝ QR SKENER ---
        function showScanner() {
            showScreen('screen-scanner');
            document.getElementById('scan-error').style.display = 'none';

            // Pokud skener ještě neexistuje, vytvoříme ho
            if (!html5QrcodeScanner) {
                html5QrcodeScanner = new Html5Qrcode("reader");
            }

            const config = { fps: 10, qrbox: { width: 250, height: 250 } };
            
            // TENTO PŘÍKAZ SPUSTÍ ŽÁDOST O POVOLENÍ KAMERY
            html5QrcodeScanner.start(
                { facingMode: "environment" }, // Zadní kamera
                config, 
                onScanSuccess, 
                onScanFailure
            )
            .catch(err => {
                // Zde chytáme situaci, kdy uživatel kameru zakázal nebo nastala chyba
                console.error("Chyba při spouštění kamery:", err);
                document.getElementById('scan-error').innerText = "Nelze spustit kameru. Ujistěte se, že jste povolili přístup a že web běží na HTTPS.";
                document.getElementById('scan-error').style.display = 'block';
                
                alert("Pro skenování QR kódu musíte povolit přístup ke kameře v prohlížeči.");
            });
        }

        function stopScannerAndReturn() {
            if (html5QrcodeScanner) {
                html5QrcodeScanner.stop().then(() => {
                    html5QrcodeScanner.clear();
                    showScreen('screen-welcome');
                }).catch(err => {
                    console.log("Chyba při zastavování", err);
                    showScreen('screen-welcome');
                });
            } else {
                showScreen('screen-welcome');
            }
        }

        function onScanSuccess(decodedText, decodedResult) {
            // Po úspěšném skenu okamžitě zastavíme kameru
            html5QrcodeScanner.stop().then(() => {
                html5QrcodeScanner.clear();
                
                let stage = stages[currentStageIndex];
                
                if (decodedText === stage.qrCode) {
                    setupTask(stage);
                } else {
                    alert("Špatný kód! Hledáte stanoviště pro úkol č. " + (currentStageIndex + 1));
                    showScreen('screen-welcome');
                }
            }).catch(err => console.log(err));
        }

        function onScanFailure(error) {
            // Tuto chybu ignorujeme, děje se, když kamera vidí obraz, ale nevidí QR kód
        }

        // --- ÚKOLY ---
        function setupTask(stage) {
            document.getElementById('task-title').innerText = "Stanoviště " + (currentStageIndex + 1);
            document.getElementById('task-desc').innerText = stage.question;
            document.getElementById('task-answer').value = "";
            document.getElementById('feedback').innerText = "";
            showScreen('screen-task');
        }

        function checkAnswer() {
            let userAnswer = document.getElementById('task-answer').value.trim().toLowerCase();
            let correctAnswer = stages[currentStageIndex].answer.toLowerCase();

            if (userAnswer.includes(correctAnswer)) {
                document.getElementById('feedback').style.color = "green";
                document.getElementById('feedback').innerText = "Správně!";
                
                setTimeout(() => {
                    startNavigation(stages[currentStageIndex].nextLocation);
                }, 1000);
            } else {
                document.getElementById('feedback').style.color = "red";
                document.getElementById('feedback').innerText = "Zkus to znovu.";
            }
        }

        // --- NAVIGACE ---
        let targetLat, targetLng;

        function startNavigation(targetLoc) {
            targetLat = targetLoc.lat;
            targetLng = targetLoc.lng;
            
            showScreen('screen-compass');
            
            // iOS oprávnění pro kompas
            if (typeof DeviceOrientationEvent !== 'undefined' && typeof DeviceOrientationEvent.requestPermission === 'function') {
                document.getElementById('ios-perm-btn').style.display = 'inline-block';
            }

            // Žádost o GPS polohu
            if (navigator.geolocation) {
                watchId = navigator.geolocation.watchPosition(updatePosition, 
                    (err) => alert("Pro navigaci musíte povolit zjišťování polohy."), 
                    { enableHighAccuracy: true }
                );
            } else {
                alert("Váš prohlížeč nepodporuje geolokaci.");
            }
            
            window.addEventListener("deviceorientation", handleOrientation, true);
        }

        function updatePosition(position) {
            const userLat = position.coords.latitude;
            const userLng = position.coords.longitude;
            
            const dist = getDistanceFromLatLonInKm(userLat, userLng, targetLat, targetLng) * 1000;
            document.getElementById('distance-meter').innerText = Math.round(dist);

            const bearing = getBearing(userLat, userLng, targetLat, targetLng);
            window.targetBearing = bearing;
        }

        function handleOrientation(event) {
            let alpha = event.alpha; 
            if(event.webkitCompassHeading) {
                alpha = event.webkitCompassHeading;
            }

            if (window.targetBearing !== undefined && alpha !== null) {
                let rotation = window.targetBearing - alpha;
                document.getElementById('arrow').style.transform = `rotate(${rotation}deg)`;
            }
        }

        function requestDeviceOrientation() {
            if (typeof DeviceOrientationEvent !== 'undefined' && typeof DeviceOrientationEvent.requestPermission === 'function') {
                DeviceOrientationEvent.requestPermission()
                    .then(response => {
                        if (response === 'granted') {
                            document.getElementById('ios-perm-btn').style.display = 'none';
                        } else {
                            alert('Povolení kompasu zamítnuto');
                        }
                    })
                    .catch(console.error);
            }
        }
        
        function openMapyCZ() {
            if(targetLat && targetLng) {
                window.open(`https://mapy.cz/turisticka?q=${targetLat},${targetLng}`, '_blank');
            }
        }

        // --- MATEMATIKA ---
        function getDistanceFromLatLonInKm(lat1,lon1,lat2,lon2) {
            var R = 6371; 
            var dLat = deg2rad(lat2-lat1); 
            var dLon = deg2rad(lon2-lon1); 
            var a = Math.sin(dLat/2) * Math.sin(dLat/2) + Math.cos(deg2rad(lat1)) * Math.cos(deg2rad(lat2)) * Math.sin(dLon/2) * Math.sin(dLon/2); 
            var c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a)); 
            return R * c;
        }

        function getBearing(startLat, startLng, destLat, destLng){
            startLat = deg2rad(startLat); startLng = deg2rad(startLng);
            destLat = deg2rad(destLat); destLng = deg2rad(destLng);

            y = Math.sin(destLng - startLng) * Math.cos(destLat);
            x = Math.cos(startLat) * Math.sin(destLat) -
                Math.sin(startLat) * Math.cos(destLat) * Math.cos(destLng - startLng);
            brng = Math.atan2(y, x);
            brng = rad2deg(brng);
            return (brng + 360) % 360;
        }

        function deg2rad(deg) { return deg * (Math.PI/180) }
        function rad2deg(rad) { return rad * (180/Math.PI) }

    </script>
</body>
</html>
